# Database configuration
# NOTE: Keep DATABASE_URL as a normal Postgres URL (postgresql:// or postgres://).
# The Google ADK session service will automatically derive an async SQLAlchemy URL
# (postgresql+asyncpg://...) at runtime.
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
PG_POOL_MIN_SIZE=5
PG_POOL_MAX_SIZE=60
PG_COMMAND_TIMEOUT=90

# Backend API Port
BACKEND_PORT=8002

# Local health-smoke mode for fresh-clone checks.
# Set to true only when verifying the backend can import/start and serve /api/health
# without PostgreSQL, Redis, sandbox, or model-provider services.
ROYS_ALPHA_BACKEND_SMOKE_MODE=false

# JWT configuration
JWT_SECRET_KEY=<GENERATE_A_STRONG_RANDOM_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_MAX_CONNECTIONS=256
REDIS_PUBSUB_SOCKET_TIMEOUT=30
REDIS_PUBSUB_HEALTH_CHECK_INTERVAL=30

# Shadow Clone (影分身) mode + guardrails
SHADOW_CLONE_DEFAULT_MODE=auto
SHADOW_CLONE_CONFIRMATION_TIMEOUT=300
SHADOW_CLONE_SUBAGENT_TIMEOUT=1200
SHADOW_CLONE_SANDBOX_CMD_TIMEOUT=600
SHADOW_CLONE_COORDINATOR_TIME_LIMIT=3600
SHADOW_CLONE_SUBAGENT_ACTOR_TIME_LIMIT=1500
SHADOW_CLONE_MAX_SUBAGENTS=50
SHADOW_CLONE_MAX_CONCURRENT=10
SHADOW_CLONE_MAIN_MODEL=openrouter-kimi-k2.5
SHADOW_CLONE_SUBAGENT_MODEL=minimax-m2.5

LOGGING_LEVEL=WARNING  # 日志级别改为 WARNING，只显示警告和错误信息。
ENV_MODE=local
MODEL_TO_USE=openrouter/minimax/minimax-m2.5

# Webhook 回调地址（用于触发器功能）
WEBHOOK_BASE_URL=http://localhost:8002

# 如果用Gemini 模型，填写自己的Key
GEMINI_API_KEY=<GEMINI_API_KEY>

# 如果用 OpenAI 模型，填写自己的Key
#OPENAI_API_KEY=<OPENAI_API_KEY>

# 如果用DeepSeek 模型，填写自己的key
DEEPSEEK_API_KEY=<DEEPSEEK_API_KEY>
DEEPSEEK_API_BASE=https://api.deepseek.com


# 如果使用Kimi模型，填写自己的Key
MOONSHOT_API_KEY=<MOONSHOT_API_KEY>
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2-thinking-turbo


# 如果使用OpenRouter模型，填写自己的Key和模型名称
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
OPENROUTER_Kimi_MODEL_NAME=moonshotai/kimi-k2-thinking
OPENROUTER_DEEPSEEK_MODEL_NAME=deepseek/deepseek-v3.2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 如果使用 OpenAI Proxy GPT-5.4，填写代理地址、Key 和模型名称
OPENAI_PROXY_API_KEY=<OPENAI_PROXY_API_KEY>
OPENAI_PROXY_BASE_URL=https://api.openai-proxy.org/v1
OPENAI_PROXY_API_BASE=https://api.openai-proxy.org/v1
OPENAI_PROXY_GPT_5_4_MODEL_NAME=gpt-5.4

# 如果用ollama 模型，填写ollama启动的模型名称以及endpoint
OLLAMA_MODEL_NAME=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434


# Langfuse 配置
# 登录地址：https://cloud.langfuse.com/auth/sign-in
# 1. 右上角创建组织（Organization）
# 2. 在组织中创建 项目（Project）
# 3. 进入 Project 中，创建一个 API_KEY
# 4. 依次复制 Secret Key 和 Public Key 即可
LANGFUSE_PUBLIC_KEY=<LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<LANGFUSE_SECRET_KEY>
LANGFUSE_HOST=http://localhost:3003
# Environment bucket for trace segregation: local-dev | staging | production
# Must be lowercase, max 40 chars, no leading "langfuse". Defaults to "default".
LANGFUSE_TRACING_ENVIRONMENT=local-dev

# 联网检索登录并注册地址：https://www.tavily.com/
TAVILY_API_KEY=<TAVILY_API_KEY>

# 网页爬取登录并注册地址：https://www.firecrawl.dev/signin
FIRECRAWL_API_KEY=<FIRECRAWL_API_KEY>
FIRECRAWL_URL=https://api.firecrawl.dev

# 沙箱服务：用于 Computer use、 Browser use 、 file search 等
# 注册地址： https://ppio.com/user/login
# PPIP/E2B 沙箱服务配置
E2B_DOMAIN=<E2B_DOMAIN>

# 登录后，右上角用户中心点击 API 秘钥管理，生成并替换成自己的
E2B_API_KEY=<E2B_API_KEY>

# https://ppio.com/sandbox/console/template 
# 替换成自己账号中的模版服务
SANDBOX_TEMPLATE_CODE=<SANDBOX_TEMPLATE_CODE>
SANDBOX_TEMPLATE_DESKTOP=<SANDBOX_TEMPLATE_DESKTOP>
SANDBOX_TEMPLATE_BROWSER=<SANDBOX_TEMPLATE_BROWSER>
SANDBOX_TEMPLATE_BASE=<SANDBOX_TEMPLATE_BASE>
SANDBOX_IO_MAX_CONCURRENT_GLOBAL=48
SANDBOX_IO_MAX_CONCURRENT_PER_SANDBOX=10
SANDBOX_TOOL_MAX_CONCURRENT_GLOBAL=48
SANDBOX_TOOL_MAX_CONCURRENT_PER_SANDBOX=10
SANDBOX_SHARED_MAX_CONCURRENT_GLOBAL=24
SANDBOX_SHARED_MAX_CONCURRENT_PER_SANDBOX=10
SANDBOX_SHARED_LEASE_TTL_SECONDS=120
AGENTSCOPE_SERVER_REGULAR_ADMISSION_BUDGET=12
SANDBOX_CREATE_MIN_START_INTERVAL_SECONDS=0.5

# PPIO_API_KEY
PPIO_API_KEY=<PPIO_API_KEY>

# Netlify 部署配置
# 用于将 Agent 创建的网页/Web App 部署到 Netlify
# 详见：SANDBOX_NETLIFY_SETUP.md
NETLIFY_AUTH_TOKEN=<NETLIFY_AUTH_TOKEN>
NETLIFY_TEAM_SLUG=your-team-slug

# 代理设置
#HTTP_PROXY=http://127.0.0.1:7890
#HTTPS_PROXY=http://127.0.0.1:7890

ADK_ENABLE_PROGRESSIVE_SSE_STREAMING=1

# Agent guardrails
AGENTSCOPE_MAX_REDIS_RESPONSES=40000
AGENTSCOPE_WRITE_STREAM_MAX_UPDATES=20
AGENTSCOPE_WRITE_STREAM_MAX_CHARS=70000


# 火山引擎
VOLCENGINE_ARK_API_KEY=<VOLCENGINE_ARK_API_KEY>
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

#阿里云
DASHSCOPE_API_KEY=<DASHSCOPE_API_KEY>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen3.5-122b-a10b

SANDBOX_AUTO_PAUSE_ON_COMPLETE=true
SANDBOX_AUTO_PAUSE_DELAY_ENABLED=true
SANDBOX_AUTO_PAUSE_GRACE_SECONDS=300
SANDBOX_IDLE_TIMEOUT_SECONDS=3600
SANDBOX_CONNECT_TIMEOUT_ON_RESUME_SECONDS=3600

# Long-term memory (ReMe sidecar, v1 task/tool only)
AGENTSCOPE_LTM_ENABLED=true
AGENTSCOPE_LTM_CONTROL=both
AGENTSCOPE_LTM_ATTACH_SCOPE=orchestrator
AGENTSCOPE_LTM_MEMORIES=task,tool
AGENTSCOPE_LTM_FAIL_OPEN=true
AGENTSCOPE_LTM_RETRIEVE_LIMIT=10
AGENTSCOPE_LTM_WRITE_GATE_ENABLED=true
AGENTSCOPE_LTM_STATIC_RECORD_ENABLED=false
AGENTSCOPE_LTM_MODEL=qwen3.5-35b-a3b
AGENTSCOPE_LTM_EMBEDDING_MODEL=text-embedding-v4
AGENTSCOPE_LTM_RERANK_MODEL=qwen3-vl-rerank
AGENTSCOPE_LTM_GLOBAL_WORKSPACE=global_task_tool_v1
AGENTSCOPE_LTM_EMBEDDING_DIMENSIONS=1024
AGENTSCOPE_LTM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTSCOPE_LTM_REME_CONFIG_PATH=agentscope_integration/memory/long_term/reme_qdrant_shared.yaml
FLOW_QDRANT_HOST=127.0.0.1
FLOW_QDRANT_PORT=6333

# Local persistence of workspace artifacts
#WORKSPACE_ARTIFACTS_ENABLED=true
#WORKSPACE_ARTIFACTS_BACKEND=local
##WORKSPACE_ARTIFACTS_LOCAL_ROOT=/var/lib/williammanus/workspace-artifacts
#WORKSPACE_ARTIFACTS_REHYDRATE_ON_RECOVERY=true

# OSS persistence of workspace artifacts (uncomment and fill in the following if using OSS)
WORKSPACE_ARTIFACTS_ENABLED=true
WORKSPACE_ARTIFACTS_BACKEND=aliyun_oss
WORKSPACE_ARTIFACTS_REHYDRATE_ON_RECOVERY=true
WORKSPACE_ARTIFACTS_OSS_ENDPOINT=https://oss-region.aliyuncs.com
WORKSPACE_ARTIFACTS_OSS_BUCKET=your-bucket-name
WORKSPACE_ARTIFACTS_OSS_ACCESS_KEY_ID=<OSS_ACCESS_KEY_ID>
WORKSPACE_ARTIFACTS_OSS_ACCESS_KEY_SECRET=<OSS_ACCESS_KEY_SECRET>
WORKSPACE_ARTIFACTS_OSS_PREFIX=workspace-artifacts/
