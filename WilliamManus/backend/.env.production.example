# WilliamManus backend production template
# Source-able by bash. Keep prod values pinned here; keep worktree-only isolation in dev wrappers.

# Core runtime
BACKEND_PORT=8002
ENV_MODE=production
LOGGING_LEVEL=WARNING
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=<REDIS_PASSWORD>
JWT_SECRET_KEY=<GENERATE_A_STRONG_RANDOM_SECRET>

# Primary model/provider secrets used by the canonical wrapper path
MODEL_TO_USE=openrouter/minimax/minimax-m2.5
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
DASHSCOPE_API_KEY=<DASHSCOPE_API_KEY>
E2B_API_KEY=<E2B_API_KEY>
SANDBOX_TEMPLATE_CODE=<SANDBOX_TEMPLATE_CODE>
SANDBOX_TEMPLATE_DESKTOP=<SANDBOX_TEMPLATE_DESKTOP>
SANDBOX_TEMPLATE_BROWSER=<SANDBOX_TEMPLATE_BROWSER>
SANDBOX_TEMPLATE_BASE=<SANDBOX_TEMPLATE_BASE>

# Pin the regular execution control path. Do not rely on code defaults.
REGULAR_EXECUTION_MODE=phase2_supervisor
REGULAR_SUPERVISOR_PERSISTENT=true
REGULAR_SUPERVISOR_SHARD_PREFIX=regular-supervisor-prod
REGULAR_SUPERVISOR_MAX_RUNS_PER_PROCESS=4
REGULAR_SUPERVISOR_PROCESSES=4
REGULAR_SUPERVISOR_THREADS=1
REGULAR_QUEUE_MAX_DEPTH=32
REGULAR_SUPERVISOR_QUEUE_MAX_DEPTH=32

# Stable production queue names
DRAMATIQ_RUN_AGENT_QUEUE=run_agent_background_prod
DRAMATIQ_SANDBOX_CLEANUP_QUEUE=sandbox_cleanup_prod
SHADOW_CLONE_SUBAGENT_QUEUE=shadow_clone_subagents_prod
REGULAR_SUPERVISOR_QUEUE=regular_supervisor_prod

# Sandbox create guardrails. Pin these to avoid silent fallback drift.
SANDBOX_CREATE_MAX_CONCURRENT_GLOBAL=4
SANDBOX_CREATE_QUEUE_TIMEOUT_SECONDS=180
SANDBOX_CREATE_LEASE_TTL_SECONDS=240
SANDBOX_CREATE_MIN_START_INTERVAL_SECONDS=0.5
SANDBOX_CREATE_RETRY_MAX_ATTEMPTS=4
SANDBOX_CREATE_RETRY_BASE_BACKOFF_SECONDS=0.5
SANDBOX_CREATE_RETRY_MAX_BACKOFF_SECONDS=8

# Canonical wrapper path expectations
SHADOW_CLONE_SUBAGENT_EXECUTION_MODE=local
WORKSPACE_ARTIFACTS_ENABLED=true
WORKSPACE_ARTIFACTS_BACKEND=local
WORKSPACE_ARTIFACTS_LOCAL_ROOT=./runtime/workspace-artifacts
WORKSPACE_ARTIFACTS_REHYDRATE_ON_RECOVERY=true

# Dev/worktree isolation lives in wrappers, not in prod:
# DRAMATIQ_RUN_AGENT_QUEUE=run_agent_background_worktree_${BACKEND_PORT}_${WORKTREE_RUNTIME_TOKEN}
# REGULAR_SUPERVISOR_SHARD_PREFIX=regular-supervisor-worktree_${BACKEND_PORT}_${WORKTREE_RUNTIME_TOKEN}
