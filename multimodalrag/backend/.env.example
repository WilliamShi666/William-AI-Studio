# Roys Legion backend public configuration template

# Auth
JWT_SECRET_KEY=<GENERATE_A_STRONG_RANDOM_SECRET>
JWT_ALGORITHM=HS256

# Runtime storage
UPLOAD_BASE_DIR=./runtime/uploads
EXTRACTION_RESULTS_DIR=./runtime/extraction_results
MAX_FILE_SIZE_MB=100

# Extraction service
INFOR_EXTRAC_SERVICE_HOST=127.0.0.1
INFOR_EXTRAC_SERVICE_PORT=8006

# V1 / VLM extraction provider
API_KEY=<MODEL_PROVIDER_API_KEY>
MODEL_NAME=qwen3-vl-plus
MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OCR 2.0 services
MINERU_API_URL=http://localhost:<MINERU_PORT>/file_parse
MINERU_BACKEND=pipeline
MINERU_VIZ_DIR=./runtime/mineru_visualizations
MINERU_TIMEOUT=600

DEEPSEEK_OCR_API_URL=http://localhost:8705/v1/ocr/pdf
DEEPSEEK_API_KEY=<DEEPSEEK_API_KEY>
DEEPSEEK_OCR_DPI=144
DEEPSEEK_OCR_BASE_SIZE=1024
DEEPSEEK_OCR_IMAGE_SIZE=640
DEEPSEEK_ENABLE_IMAGE_DESC=false
DEEPSEEK_DRAW_BBOX=true
DEEPSEEK_OCR_TIMEOUT=600

PADDLEOCR_VL_API_URL=http://localhost:8802/parse
PADDLEOCR_VL_TIMEOUT=600
PADDLEOCR_VL_MODEL_DIR=<PADDLEOCR_VL_MODEL_DIR>
PADDLEOCR_LAYOUT_MODEL_DIR=<PADDLEOCR_LAYOUT_MODEL_DIR>

# Chunking service
CHUNK_SERVICE_HOST=127.0.0.1
CHUNK_SERVICE_PORT=8001
CHUNKING_SERVICE_ENABLED=true

# Milvus API and vector database
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_API_HOST=127.0.0.1
MILVUS_API_PORT=8000
MILVUS_API_ENABLED=true

# Embeddings
EMBEDDING_URL=<EMBEDDING_API_BASE_URL>
EMBEDDING_MODEL_NAME=<EMBEDDING_MODEL_NAME>
EMBEDDING_API_KEY=<EMBEDDING_API_KEY>

# Chat / model providers
CHAT_SERVICE_HOST=127.0.0.1
CHAT_SERVICE_PORT=8501
DASHSCOPE_API_KEY=<DASHSCOPE_API_KEY>
DEEPSEEK_API_KEY=<DEEPSEEK_API_KEY>
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
