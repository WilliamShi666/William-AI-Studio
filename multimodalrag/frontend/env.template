# 前端环境变量配置模板
# 复制此文件为 .env 或 .env.local 并根据实际情况修改

# ==================== 后端服务地址 ====================

# Milvus 向量数据库 API (默认: http://localhost:8000)
VITE_MILVUS_API_URL=http://localhost:8000

# 对话检索服务 (默认: http://localhost:8501)
VITE_CHAT_API_URL=http://localhost:8501

# 多智能体辩论服务
# 开发环境推荐使用同源代理路径，避免浏览器跨域和端口限制：
# VITE_DEBATE_API_URL=/debate-api
# 如需直接访问后端端口（例如生产环境经过网关暴露），可改为完整URL：
VITE_DEBATE_API_URL=/debate-api

# PDF 提取服务 (默认: http://localhost:8006)
VITE_EXTRACTION_API_URL=http://localhost:8006

# 文本切分服务 (默认: http://localhost:8001)
VITE_CHUNK_API_URL=http://localhost:8001

# 主站后端 API（管理员面板等，默认: http://localhost:8002/api 或同源 /api）
VITE_MAIN_API_URL=http://localhost:8002/api

# ==================== 部署场景示例 ====================

# 场景1: 本地开发（所有服务在本机）
# VITE_MILVUS_API_URL=http://localhost:8000
# VITE_CHAT_API_URL=http://localhost:8501
# VITE_DEBATE_API_URL=http://localhost:8602
# VITE_EXTRACTION_API_URL=http://localhost:8006
# VITE_CHUNK_API_URL=http://localhost:8001

# 场景2: 远程服务器部署（修改为实际主机名或 IP）
# VITE_MILVUS_API_URL=http://<YOUR_SERVER_HOST>:8000
# VITE_CHAT_API_URL=http://<YOUR_SERVER_HOST>:8501
# VITE_DEBATE_API_URL=http://<YOUR_SERVER_HOST>:8602
# VITE_EXTRACTION_API_URL=http://<YOUR_SERVER_HOST>:8006
# VITE_CHUNK_API_URL=http://<YOUR_SERVER_HOST>:8001

# 场景3: 生产环境（使用域名）
# VITE_MILVUS_API_URL=https://api.yourdomain.com/milvus
# VITE_CHAT_API_URL=https://api.yourdomain.com/chat
# VITE_DEBATE_API_URL=https://api.yourdomain.com/debate
# VITE_EXTRACTION_API_URL=https://api.yourdomain.com/extraction
# VITE_CHUNK_API_URL=https://api.yourdomain.com/chunk
